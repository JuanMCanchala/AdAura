# Copiar a .env (raíz, para forge) y a apps/web/.env.local (para Next).
# Sin las tres primeras la app corre igual: el motor, el dashboard y el storefront
# funcionan sin cadena, y el panel "Prove it on chain" dice qué falta.

# --- wallet del operador -----------------------------------------------------
# Índice 0 financia la campaña, registra agentes y liquida revenue.
# Cada agente deriva del índice N+1 de este mismo mnemónico.
DEPLOYER_MNEMONIC=""
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- red ---------------------------------------------------------------------
CHAIN_ID=133
RPC_URL=https://testnet.hsk.xyz
EXPLORER_URL=https://testnet-explorer.hskchain.net

# --- contratos (llenar después del deploy) -----------------------------------
TREASURY_ADDRESS=
TOKEN_ADDRESS=

# --- pitches habladas (opcional) ---------------------------------------------
# Sin esto los agentes igual pitchean, pero con plantillas: no miran la foto.
ANTHROPIC_API_KEY=

# --- opcionales --------------------------------------------------------------
# Quién cobra los pagos x402. Por defecto una dirección quemada.
AD_NETWORK_ADDRESS=
# Gas nativo que se le gotea a cada wallet nueva para que pueda firmar.
GAS_DRIP_ETHER=0.002
